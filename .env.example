# Copy to `.env` and fill in. The server auto-loads this file (via dotenv).
# Everything here is optional for a local/demo run — with none of it set, Conduit
# boots a zero-config, fully in-memory gateway using mock providers.

# --- Provider API keys (enable real upstreams) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Admin + demo ---
# Bearer token for /admin/* routes. CHANGE THIS for anything non-local.
ADMIN_TOKEN=dev-admin-token
# Plaintext demo virtual key seeded on boot.
DEMO_KEY=ck-demo-0000000000000000000000000000

# --- Server ---
PORT=8080
LOG_LEVEL=info

# --- Storage backends ---
# Set these to switch from in-memory to shared backends. docker-compose sets them
# automatically; uncomment for a local Redis/Postgres instead.
# REDIS_URL=redis://127.0.0.1:6379
# DATABASE_URL=postgres://conduit:conduit@127.0.0.1:5432/conduit

# --- Grafana (docker-compose only) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
